.fa {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.footer{
  display: flex;
  width: 100%;
}
.footerdivimage{
    opacity: 70%;
    text-align: center;
    
    width: 21px;
    margin-right: 8px;
    margin-top: 10px;
}

.footer-menu{
  border-top:1px solid #e5e5e5;
  padding: 20px 100px 20px 100px !important;
  font-family:system-ui,sans-serif;
  display: flex;
  flex-direction: column;
}

.footer-menu li {
padding-left: 2em;

}

.footer .footer-dropdown{
  padding:10px 0;

}

.footer .footer-lists{
  display: flex;
}

.footer .footer-toggle{
  width:100%;
  
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  padding:0em 2em  ;
  background:none;
  border:0;
  cursor:pointer;
 
}

.footer .footer-panel{
  overflow:hidden;
  max-height:0;
  transition:max-height .25s ease;
}

.footer .footer-links{
  list-style:none;
  padding:8px 0 0;
  margin:0;
  display:grid;
 
}

.footer .footer-links a{

  color:#ffffff;
}

/* caret */
.footer .footer-toggle .caret{
  display:inline-block;
  transition:transform .25s ease;
}


.footer .footer-toggle[aria-expanded="true"] .caret{
  transform:rotate(180deg);
}


.footer .footer-social {
  margin-left: auto;
  
   
}
.footer .footer-social ul li{
  display:inline-block;
  padding: 0em;
}




/* ------------------copyright-----------------  */

.copyright{
  display: flex;
  flex-direction: row;
  align-items: center;
  
}
.copyright img{
  width: 210px;
  padding-left: 1.5em;
  object-fit: contain;
}

.copyrighttext{
  padding: 0px;
  

}

.dmca{
  display: flex;
  justify-content: end;
  
}

@media (max-width: 1250px)  {
  

  .footer .footer-lists{
    flex-direction: column;

  }

  .copyright{
  flex-direction: column;
  
}

.footer_logo{
  max-width: 100%;
}

.footer_logo img{
  max-width: 90%;
}

  
}


/* -----------side footer------------- */

.side-footer{
  position: sticky;
  top: 20px;
  height: 50%;
}

.side-footer .footer-lists{
  color: rgba(255, 255, 255, 0.788);
  display: flex;
  flex-direction: column;
  
}

.side-footer .footer-toggle{
  width:100%;
  padding:.5em 0em 0em;
  font-size: 12px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  background:none;
  border:0;
  cursor:pointer;
 
}

.side-footer .footer-panel{
  overflow:hidden;
  max-height:0;
  transition:max-height .25s ease;
}

.side-footer .footer-links{
  list-style:none;
  padding:0em 0;
  margin:0;
  display:grid;
  gap: 2px;
  font-size: 12px;
 
}

.side-footer .footer-links a{
  font-weight: 400;
  color:rgba(199, 199, 199, 0.623);
}

/* caret */
.side-footer .footer-toggle .caret{
  display:inline-block;
  transition:transform .25s ease;
}


.side-footer.footer-toggle[aria-expanded="true"] .caret{
  transform:rotate(180deg);
}


.side-footer .footer-social .socialmedia {
 display: block;
 position: relative;
 margin-top: 0px;
 gap: 15px;
 
}
.side-footer .footer-social .dmca-badge{
  padding-top:3em ;
  padding-bottom: .5em;
}

.side-footer .copright{
  
}


#page-footer .side-footer.copyrightline{
  position: relative;
  top: 50px;
}

@media (max-width: 1050px)  {
  .side-footer .footer-lists{
    flex-direction: row;
    justify-content: space-around;
  }

  .side-footer .footer-social{
    display: flex;
    flex-direction: row;
    align-items:center;
    justify-content: center;
    background-color: #600;
    margin: 1em;
    
  }

  .side-footer .footer-social .dmca-badge{
  padding-top:1em ;
  padding-bottom: .5em;
}

  

  .side-footer{
  padding-top: 2em ;
  max-width: 100%;
  margin-left: 0em;
  position: relative;
}
  
}