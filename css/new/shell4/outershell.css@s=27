  /* -----header------ */
  .header{
    position: sticky;
    top: 0;
    z-index: 9999;
    background-color: #600f02;
  }

  .header li a{
    color: #f78d03!important;
  }
.header_wrapper{
    background-color: #600f02;
    width: 90%;
    display: grid;
    max-width: 1200px;
    grid-template-columns: max-content 1fr;
    padding: 35px 0 18px 0;
    margin: 0 auto;
    
}

.header_champion {
    display: flex;
    align-items: start;
}
.header_champion img{
    max-width: 330px;
}
.header_cta{
    height: 3em;
    display: flex;
    gap: 1.9em;
    justify-content: end;
    align-items: end;
    padding-bottom: 1em;
}
.header_cta a{
    text-transform: uppercase;
    letter-spacing: 1.8px;
    font-family: Outfit;
    color: #f78d03!important;
    padding: .3em .5em ;
    border: 1.5px solid #f78d03;
    display: flex;
    align-items: center;
    border-radius: 5px;
    text-decoration: none;
    font-size: 22px;
    font-weight: 700;
    height: 1.2em;
    transition: 
    color .25s ease,
    border .25s ease
    ;
}

.header_cta a:hover{
color: white!important;
border:1.5px solid white;
}

.header_wrapper .header-links{
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: end;
    list-style: none;
    gap: 1em;
    
}
.header_wrapper .header-links{
    margin-bottom: 0;
}

.header-links li {
    font-family: Outfit;
    font-size: 1.5em;
    color: #f78d03; 
    transition: color .25s ease;
}

.header-links li a{
    font-weight: 650;
    font-size: 1.1em;
    font-family: "PT Sans", sans-serif;
}

.header-links div{
    font-family: "PT Sans", sans-serif;
    font-size: 1.1em;
    font-weight: 700;
    color: #f78d03;
    transition: color .25s ease;
}

.header-links li a:hover, .header-links div:hover{
    color: white!important;
    cursor: pointer;
    

}

.header-links div:has(.active){
    color: white;
}

.header-toggle i{
    transform: rotate(-90deg);
    transition: .25s ease;
}

.header-toggle:has(.active) i{
    transform: rotate(0deg);
}


.dropdown {
    display: none;
    margin-top: .25em;
    padding: .2em .5em;
    background-color: #211e1c;
    border-top: 1px solid white;
    box-shadow: 0px 3px 4px 1px #600f0286;
    
}

.header li .dropdown a{
    display: flex;
    align-items: center;
    line-height: 2em;
    font-size: .8em;
    color: white!important;
    transition: color .25s ease;
  
}

.header li .dropdown a img{
    height: 1.6em;
}

.header-links .bordered{
    border: 1.5px solid #f78d03;
    border-radius: 5px;
    padding: 0em .5em ;
    margin: .5em 0em;
  
}

.header li .dropdown a:hover{
    color: #f78d03!important;

}

.dropdown.active {
    display: flex;
    flex-direction: column;
    align-items: start;
    position: absolute;
}


.mobile-dropdown{
    display: none;
}
.mobile-header{
    position: relative;
}

.mobile-dropdown-menu{
    display: flex;
    flex-direction: column;
    position: absolute;
    opacity: 0;
    background-color: #211e1c;
    border-top: 1px solid white;
    padding: 0em 2em ;
    /* margin: 2em; */
    top: 5em;
    flex-direction: column;
    align-items: start;
    width: 100%;
    left: 0;
    height: 100dvh;
    visibility: hidden;
    transform: translateX(-100%);
    transition:
        opacity .3s ease,
        transform .3s ease,
        visibility 0s linear .3s;
}


.mobile-dropdown-menu.active{
	padding-top:40px;
    opacity: 1;
    visibility: visible;
    transform: translateX(0);

    transition:
        opacity .3s ease,
        transform .3s ease;
}

.mobile_header:has(.active)::before{
    content: 'X';
    position: absolute;
    font-size: 2.5em;
    font-family: outfit;
    background-color: #600f02;
    color:#f78d03;
    
    top: 20px;
    right: 15px;
    z-index: 999;
    width: 1em;
    height: 1em;
}

.mobile-dropdown-menu .header_cta{
    font-size: 1.2em;
}

.mobile-dropdown-menu .header-links{
    flex-direction: column;
    align-items: start;
    gap: .5em;
    
    line-height: 2em;
    padding: 0em;
}

.header .mobile-dropdown-menu .header-links li a{
    color: white!important;
    text-align: start;
    
}

.mobile-dropdown-menu .header-links div{
    color: white;
}

.mobile-dropdown-menu .dropdown{
    position: relative;
    background-color: inherit;
    border-top: none;
    box-shadow: none;
    width: 90vw;
    
}



.mobile-dropdown-menu .header-toggle{
    display: flex;
    justify-content: start;
    align-items: center;
}

.mobile-dropdown-menu .header-toggle:has(.active)  {
    color: #f78d03!important;
}

.mobile-dropdown-menu .header-toggle i{
    color: white!important;
}

.mobile-dropdown-menu .header-toggle:has(.active) i{
    color: #f78d03!important;
}

/* --------main body content--------- */


  .contentTransBG .content{
    height:90dvh;
    padding: 0;
    display: grid;
    grid-template-columns: 50% 1fr;

  }

 

.side_logos{
    overflow: hidden;
    position: relative;
    
}
.side_logos img{
    position: absolute;
    object-fit: cover;
    height: 100%;
    left: -25%;
    animation: logomovement 20s linear infinite;
}

 @keyframes logomovement {
  0%   {left: -25%;}
  100% {left: -55%;}
}

.side_logos::after{
    content: '';
    position: absolute;
    right: 0;
    background: linear-gradient(270deg,rgba(26, 26, 26, 1) 0%, rgba(255, 255, 255, 0) 100%);
    height: 100%;
    width: 40%;
}

