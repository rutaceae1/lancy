/* -------footer------- */
.footer{
    background-color: #211e1c;
    position: relative;
    bottom: 0;
    /*max-height: 25dvh;*/
    
}
.outerfooter{
    width: 100%;
}
.outerfooter .footer-wrapper{
    width: 90%;
    display: grid;
    max-width: 1200px;
    grid-template-columns: max-content 2fr max-content;
    padding: 18px 0;
    margin: 4em auto;

}

.footer_champion img{
    max-width: 250px;
}

.footer_champion .subtitle{
    font-family:Ubuntu, sans-serif ;
    padding: .5em 0;
    font-size: 1.3em;
}
.footer_champion .copyright{
    background-color: #211e1c;
    font-size: 1em;
    font-family: Ubuntu, sans-serif;
    border: none;
    margin: 0;
    padding: 0;
}

.footer_externals{
    display: flex;
    flex-direction: column;
    /* justify-content: center; */
    align-items: center;
    gap: .5em;
}

.footer_externals a{
    border: 1px solid white;
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: .5em;
    padding: .2em .5em;
    /* width: 50%; */
    border-radius: 6px;
    font-weight: 600;
    font-size: 1.4em;
    font-family: Outfit;
}

.footer_externals a:hover{
    color: #f78d03;
    border:1px solid #f78d03;
    text-decoration: none;
}

.footer_externals .socialmedia{
    margin-top: 0;
    gap: .5em;

}

.footer_externals .socialmedia a{
    border: none;
    color: white;
}

.footer_externals .socialmedia a:hover{
    color: #f78d03;
}
.footer .footer-links{
    gap: .5em;
}
.footer .footer-links a{
    font-weight: 400;
    font-size: 1.4em;
    gap: .5em;
}


/* dropdowns  */
.outerfooter .footer-toggle[aria-expanded="true"] i{
    transform:rotate(-0deg)!important;
}
.outerfooter .footer-toggle i{
    transition:transform .25s ease;
}
.outerfooter .footer-dropdown, .outerfooter .footer-links{
    font-family: Outfit;
}

.outerfooter .footer-dropdown:hover, .outerfooter .footer-links a:hover{
    color:#f78d03 ;
    text-decoration: none;
}

.footer .outerfooter .footer-dropdown{
    padding: 0px;
    font-size: 1.7em;
}
.outerfooter .footer-lists{
    display: flex;
    gap: 1em;
    justify-content: center;
    
}

.outerfooter .footer-toggle{
    padding: 0em!important;
    font-size: 1em;
}



/* --------------bespoke pages--------------- */

/* login */

.login{
    display: flex;
    flex-direction: column;
    gap: 1em;
    
}

.login .title{
    margin: 0em;
}

.login .subtitle{
    font-style: italic;
    padding: .2em 0em 0em 0em;
    border: none;
    font-size: .9em;
    color: rgba(255, 255, 255, 0.7);
    font-weight: 300;
    opacity: 0;
    animation: fadeIn .5s ease forwards ;
    /* pulse 2s ease-in-out 0.3s infinite */
}


@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}


/* signup */

.signup {
    display: flex;
    flex-direction: column;
    gap: .5em;
}

.signup .button{
    padding-top: 1em;

}

.mobile_landing{
    display: none;
}

.signup .inputform span{
        display: flex;
        align-items: center;
        padding: 0 1em 0 0 ;
        font-family: outfit;
        font-size: 1em;
    }

.signup .inputform {
        display: flex;
        flex-direction: row;
        justify-content: center;

}

/* blocked */
.blocked {
    display: flex;
    flex-direction: column;
    gap: 1em;
    
}
.blocked{
    font-family: outfit;
    font-size: 1em;

}

.blocked .cta{
    display: inline;
}

.blocked .cta span{
    padding-right: .5em;
    color: rgba(255, 255, 255, 0.7);
}

.blocked .cta a{
    color: #f78d03b7;
}

.blocked .cta a:hover{
    color: #f78d03;
    text-decoration: none;
}

/* signup success */

.signup_success{
    display: flex;
    /* justify-content: center; */
    align-items: center;
    flex-direction: column;
    text-align: center;
    gap: 1em;
    font-size: 1.2em;
    font-family: outfit;
}

/* signup_confirm */

.signup_confirm{
    display: flex;
    flex-direction: column;
    gap: 1em;
    font-size: 1.2em;
}

.signup_confirm .inputform{
    display: flex;
    flex-direction: column;

}

.signup_confirm .last_cta{
    opacity: .7;
    font-size: 0.9em;
}

/* logout */
.logout .title{
    text-align: center;
}
.logout .button{
    margin-top: 1em;

}
.logout .socialmedia{
    margin-top: 1em;
    justify-content: center;
    gap: .5em;

}

.logout .socialmedia a{
    color: white;
    font-size: 2em;

}

.logout .socialmedia a:first-of-type{
    font-size: 1.6em;
}

.logout .socialmedia a:hover{
    color: #f78d03;

}

/* delete */

.delete{
    display: flex;
    flex-direction: column;
    gap: 1em;
}

@media (max-width: 1050px) {
    .content {
        margin-top: 0px!important;
    }
}

/* -----------mobile----------- */

@media (max-width: 1250px) {

    .footer .outerfooter .footer-lists{
        flex-direction: row;
    }
    
}


@media (min-width: 1028px) {
	.mobile-dropdown-menu{display:none;}
}

@media (max-width: 1024px) {
    .header{
        position: fixed;
        width: 100%;
    }
    .header_wrapper .desktop_header{
        display: none;
    }

    .header_wrapper .mobile-dropdown{
        display: block;
        position: absolute;
        right: 1em;
        top:1.5em;
    }
    .header_wrapper .mobile-dropdown i{
        font-size: 2em;
        color: #f78d03;
    }

    .header_champion{
        padding: 1.25em 1.5em;
        margin-bottom: .5em;
    }
    .header_champion img{
        max-width: 225px;
    }

    .header_wrapper{
        width: 100%;
        /* display: flex;
        justify-content: center; */
        padding: 0;
    }

    .outerfooter .footer-wrapper{
        grid-template-columns: 1fr 1fr;
        gap: 1em;
    }

    .outerfooter .footer-wrapper .footer_externals, .outerfooter .footer-wrapper .footer_champion .copyright{
        align-items: start;
        text-align: start;
    }
    

    .contentTransBG:has(.content){
        position: relative;
        /* top: -80ps */
        height: 100dvh;
    }
     .contentTransBG .content{
        margin-top: 0px;
        height: 100dvh;
        grid-template-columns: 100%;
        position: relative;
    }

    .side_logos{
        position: absolute;
        opacity: 1;
        width: 100%;
        height: 50%;
        top: 0;
        z-index: 999;
    }

    .side_logos img{
        object-fit: cover;
        height: 200%;
        left: -60%;
        animation-duration: 15s;
    }

    .side_logos::after{
        width: 100%;
        background: linear-gradient(0deg, rgba(26, 26, 26, 1) 0%, rgba(255, 255, 255, 0) 100%);

    }

    .float_right{
        z-index: 9999;
    }

    .float_right .form{
        max-width: 80%;

    }


    /* ---------bespoke pages----------- */

   

    /* --blocked-- */

    .content:has(.blocked){
        padding: 5em 0em 0em;
        background-color: rgb(26, 26, 26);

    }
    .blocked{
        padding: 2em 0em 0em;
    }

    .float_left{
        position: relative;
        z-index: 999;
        padding: 1em 0em;
        width: 100%;
    }

    .float_left a{
        width: 80%;
    }

    .float_left img{
        width: 100%;
        max-width: 60vw;
    }

    }


    @media (max-width: 800px) {

    .footer{
        max-height: 60dvh;
    }

    .footer .outerfooter .footer-wrapper{
        display: flex;
        flex-direction: column;
        gap: 1em;

    }    

    .footer .outerfooter .footer_champion{
        display: flex;
        flex-direction: column;
        align-items: center;
        

    }

    .footer .outerfooter .footer-lists{
        flex-direction: column;
        align-items: center;
       
    }

    .footer .outerfooter .footer-links{
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .footer .outerfooter .footer-links a{
        font-weight: 400;
    }

    .outerfooter .footer_externals{
        align-items: center;
    }

    .outerfooter .footer-wrapper .footer_externals, .outerfooter .footer-wrapper .footer_champion .copyright{
        align-items: center;
        text-align: center;
    }

    /* Sign up */

     .content:has(.signup){
        height: 220dvh;
        background-color: rgb(26, 26, 26);
    }

    .content:has(.signup) .side_logos img{
