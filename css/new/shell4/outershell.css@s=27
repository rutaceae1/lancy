        border-bottom: 2px solid #f78d03;
    }

    .mobile_landing .cta{
        color: white;
        font-family: Outfit;
        font-size: 1.2em;
        position: absolute;
        bottom: 7%;
    }

    .mobile_landing .cta a{
        color: #f78d03;
    }

    .signup {
        padding: 5em 0;
        gap: .5em;
    }

    .signup .title{
        margin: 1em 0em 0em ;
    }
    
}

@media (max-width: 450px) {

    .float_left img{
        max-width: 80vw;
    }


}




  
