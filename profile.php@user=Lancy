<!-- open and close footer -->
<script>
  (function () {
    const toggles = document.querySelectorAll('.footer-toggle');

    function openPanel(btn, panel) {
      panel.hidden = false;

      // start from 0, then expand to natural height
      panel.style.maxHeight = '0px';
      panel.offsetHeight; // force reflow so transition triggers
      panel.style.maxHeight = panel.scrollHeight + 'px';

      btn.setAttribute('aria-expanded', 'true');
    }

    function closePanel(btn, panel) {
      // collapse from current height to 0
      panel.style.maxHeight = panel.scrollHeight + 'px';
      panel.offsetHeight; // force reflow
      panel.style.maxHeight = '0px';

      btn.setAttribute('aria-expanded', 'false');

      panel.addEventListener('transitionend', function onEnd(e) {
        if (e.propertyName !== 'max-height') return;
        panel.hidden = true;
        panel.removeEventListener('transitionend', onEnd);
      });
    }

    toggles.forEach((btn) => {
      const panelId = btn.getAttribute('aria-controls');
      const panel = document.getElementById(panelId);

      if (!panel) return;

      btn.addEventListener('click', () => {
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        isOpen ? closePanel(btn, panel) : openPanel(btn, panel);
      });

      // keep animation correct if links wrap / viewport changes
      window.addEventListener('resize', () => {
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        if (isOpen && !panel.hidden) {
          panel.style.maxHeight = panel.scrollHeight + 'px';
        }
      });
    });
  })();
</script>
