<script>
document.addEventListener('DOMContentLoaded', () => {

    const items = document.querySelectorAll('.header-links > li');

    items.forEach(item => {

        const toggle = item.querySelector('.header-toggle');
        const dropdown = item.querySelector('.dropdown');
        const icon = toggle?.querySelector('i');

        // Ignore items without dropdowns
        if (!toggle || !dropdown || !icon) return;

        toggle.addEventListener('click', (e) => {
            e.stopPropagation();

            const isOpen = dropdown.classList.contains('active');

            // Close all dropdowns
            items.forEach(other => {
                other.querySelector('.dropdown')?.classList.remove('active');
                other.querySelector('.header-toggle i')?.classList.remove('active');
            });

            // Open this one if it wasn't already open
            if (!isOpen) {
                dropdown.classList.add('active');
                icon.classList.add('active');
            }
        });

    });

    // Close all when clicking outside
    document.addEventListener('click', () => {
        items.forEach(item => {
            item.querySelector('.dropdown')?.classList.remove('active');
            item.querySelector('.header-toggle i')?.classList.remove('active');
        });
    });

});
</script>


